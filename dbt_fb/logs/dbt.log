[0m14:23:51.768026 [debug] [Thread-1 (]: On model.dbt_fb.mart_cogs_margin: /* {"app": "dbt", "dbt_version": "1.12.0b1", "profile_name": "dbt_fb", "target_name": "dev", "node_id": "model.dbt_fb.mart_cogs_margin"} */

  
  

with revenue as (
    select
        item_sku,
        sum(total_revenue)              as total_revenue_gbp
    from "fb_warehouse"."public"."int_daily_sales"
    group by 1
),
cogs as (
    select
        item_sku,
        sum(total_cost_gbp)             as total_cost_gbp
    from "fb_warehouse"."public"."int_cogs_matched"
    group by 1
),
joined as (
    select
        r.item_sku,
        r.total_revenue_gbp,
        c.total_cost_gbp,
        round(r.total_revenue_gbp - c.total_cost_gbp, 2)           as gross_profit_gbp,
        round((r.total_revenue_gbp - c.total_cost_gbp)
            / nullif(r.total_revenue_gbp, 0) * 100, 1)             as gross_margin_pct
    from revenue r
    left join cogs c using (item_sku)
)
select * from joined
order by gross_margin_pct desc
  
  limit 5

